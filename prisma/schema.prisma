generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  OWNER
  ADMIN
}

enum BoatStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RefundStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(GUEST)
  phone        String?
  // Внутренний номер судовладельца для дашборда (0001, 0002, ...).
  // Присваивается автоматически при регистрации (DEFAULT nextval(owner_number_seq) в БД).
  ownerNumber  Int?      @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  boats        Boat[]
  bookings     Booking[]
  reviews      Review[]

  // Платёжные реквизиты судовладельца для выплат (ИП/ООО) — нужны для сплитования
  // платежей через CloudPayments и/или прямых выплат на расчётный счёт.
  payoutLegalName   String? // Полное наименование: ИП Иванов И.И. / ООО "Компания"
  payoutInn         String?
  payoutOgrn        String? // ОГРНИП или ОГРН
  payoutBankName    String?
  payoutBik         String?
  payoutAccount     String? // Расчётный счёт
  payoutCorrAccount String? // Корреспондентский счёт
  payoutUpdatedAt   DateTime?

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Boat {
  id           String         @id @default(cuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  capacity     Int
  pricePerDay  Decimal        @db.Decimal(10, 2)
  priceUnit   String         @default("SUTKI")
  // Основание цены: BOAT — за весь катер целиком, PERSON — за одного человека
  // (умножается на число людей в брони). Независимо от единицы (час/сутки/тур) —
  // например, "час с человека" или "тур за лодку целиком".
  priceBasis   String         @default("BOAT")
  // Внутренний номер катера для дашборда (00001, 00002, ...).
  // Присваивается автоматически при создании (DEFAULT nextval(boat_number_seq) в БД).
  boatNumber   Int?           @unique
  location     String
  routes       String[]
  images       String[]
  status       BoatStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     Booking[]
  availability Availability[]
  reviews      Review[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model DepartureLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Availability {
  id        String   @id @default(cuid())
  boatId    String
  boat      Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  available Boolean  @default(true)

  @@unique([boatId, date])
}

model Booking {
  id          String        @id @default(cuid())
  boatId      String
  boat        Boat          @relation(fields: [boatId], references: [id])
  // Зарегистрированный гость (null для гостевых бронирований без регистрации)
  guestId     String?
  guest       User?         @relation(fields: [guestId], references: [id])
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  // Время начала аренды (для тарифов "час"/"тур") — используется, чтобы один и тот же
  // временной слот на дату не могли занять два гостя одновременно.
  startTime   String?
  totalPrice  Decimal       @db.Decimal(10, 2)
  commission  Decimal       @db.Decimal(10, 2)
  // Количество человек в брони — важно для тур-тарифа (priceUnit = TOUR),
  // где цена указана за человека, а не за весь катер.
  guestCount  Int           @default(1)
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  review      Review?

  // Данные гостя без регистрации
  guestName   String?
  guestPhone  String?
  guestEmail  String?
  bookingCode String?  @unique // Уникальный код для получения статуса по email/SMS

  // Запрос на возврат средств от Гостя (см. оферту п.4) — заявка фиксируется здесь,
  // фактический возврат денег выполняется Оператором вручную (до интеграции возвратов в CloudPayments).
  refundStatus      RefundStatus @default(NONE)
  refundReason      String?
  refundRequestedAt DateTime?
  refundDecidedAt   DateTime?

  // CloudPayments
  cloudPaymentsInvoiceId     String? // Id платёжной ссылки (Orders API, создаётся при оплате)
  cloudPaymentsTransactionId String? // TransactionId фактической успешной транзакции (из вебхука Pay)
  paidAt                     DateTime?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  boatId    String
  boat      Boat     @relation(fields: [boatId], references: [id])
  guestId   String
  guest     User     @relation(fields: [guestId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}
